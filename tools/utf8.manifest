<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Embedded into every exe by build.ps1: the process's ANSI code page is UTF-8 (Windows 10 1903 and later), so
     argv, CreateFileA, fopen and std::filesystem::path::string() carry paths with any characters; ASCII paths are
     unchanged. longPathAware lifts the 260-character limit where Windows allows it (LongPathsEnabled). -->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <activeCodePage xmlns="http://schemas.microsoft.com/SMI/2019/WindowsSettings">UTF-8</activeCodePage>
      <longPathAware xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">true</longPathAware>
    </windowsSettings>
  </application>
</assembly>
